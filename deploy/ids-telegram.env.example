# ============================================================
#  GARDA-IoT · konfigurasi notifikasi Telegram
#  Salin ke /etc/ids-telegram.env lalu: sudo chmod 600 /etc/ids-telegram.env
#  Dibaca oleh alerting/ids_alert.py dan alerting/telegram_webhook.py
# ============================================================
TELEGRAM_BOT_TOKEN=<TOKEN_BOT_DARI_BOTFATHER>
TELEGRAM_CHAT_ID=<ID_NUMERIK_AKUN_OPERATOR>

# Lokasi token pengujian IDS yang sama dengan GARDA_IDS_TOKEN_PATH
IDS_TEST_TOKEN_PATH=/home/<user>/garda-iot/edge-server/.ids_test_token
