<!--
  GARDA-IoT · tambahkan blok berikut ke /var/ossec/etc/ossec.conf (Wazuh Manager),
  di dalam <ossec_config>, lalu: sudo systemctl restart wazuh-manager
  <agent_id> harus sama dengan ID agent Raspberry Pi (cek: /var/ossec/bin/agent_control -l)
-->
<command>
  <name>ids-alert</name>
  <executable>ids_alert.py</executable>
  <timeout_allowed>no</timeout_allowed>
</command>

<active-response>
  <command>ids-alert</command>
  <location>defined-agent</location>
  <agent_id>001</agent_id>
  <rules_id>100100</rules_id>
</active-response>
