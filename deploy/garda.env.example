# ============================================================
#  GARDA-IoT · konfigurasi edge server (server.py & dos_attack.py)
#  Salin ke /etc/garda-iot/garda.env lalu isi sesuai jaringan lab:
#    sudo mkdir -p /etc/garda-iot
#    sudo cp deploy/garda.env.example /etc/garda-iot/garda.env
#    sudo chmod 644 /etc/garda-iot/garda.env   # hanya berisi IP & path, tanpa rahasia
#  Setiap nilai juga dapat di-override lewat environment variable.
# ============================================================

# --- Perangkat di jaringan lokal (LAN) ---
GARDA_ESP32_IP=192.168.X.X        # IP statis ESP32 (sama dengan ESP32_STATIC_IP di config.h)
GARDA_PI_IP=192.168.X.X           # IP Raspberry Pi 5 (wlan0)
GARDA_WAZUH_IP=192.168.X.X        # IP Wazuh Manager

# --- Lingkungan uji (network namespace ids-attacker) ---
GARDA_ATTACKER_IP=10.200.0.2      # IP namespace penguji (satu-satunya IP yang dapat diblokir IPS)
GARDA_IDS_HOST_IP=10.200.0.1      # IP sisi host veth (tujuan registrasi penguji)

# --- Lokasi file (opsional; default relatif terhadap folder edge-server) ---
# GARDA_IDS_TOKEN_PATH=/home/<user>/garda-iot/edge-server/.ids_test_token
# GARDA_MODEL_DIR=/home/<user>/garda-iot/edge-server/models
